{%- comment -%}
  ============================================================
  Contador regressivo reutilizável (barra do topo + hero + PDP).
  A data-limite, cores e mensagem vêm das Configurações do tema
  (grupo "Contador de oferta"). Um lugar só alimenta os pontos.
  Parâmetros:
    variant: 'bar' (topo) | 'hero' (banner) | 'product' (PDP)
    message: texto opcional (sobrepõe a mensagem global)
    cta_text / cta_link: botão opcional (só na barra do topo)
  Motor 100% Safari-safe: alvo calculado server-side em epoch,
  cliente só faz (target*1000 - Date.now()). Sem new Date(string).
  ============================================================
{%- endcomment -%}
{%- liquid
  assign variant = variant | default: 'bar'
  assign msg = message | default: settings.cd_message
  assign raw = settings.cd_end | default: ''
  assign iso = raw | strip | replace: ' ', 'T' | append: '-03:00'
  assign target = iso | date: '%s'
  assign bg = bg | default: settings.cd_bg | default: '#E10E1B'
  assign fg = fg | default: settings.cd_text | default: '#ffffff'
  assign hide_done = settings.cd_hide_when_done
  assign cta_text = cta_text | default: ''
  assign cta_link = cta_link | default: ''
-%}
{%- if raw != blank -%}
  <div
    class="bcd bcd--{{ variant }}"
    data-botanika-countdown
    data-countdown-target="{{ target }}"
    {% if hide_done %}data-hide-done="1"{% endif %}
    style="--bcd-bg:{{ bg }};--bcd-fg:{{ fg }};"
  >
    <div class="bcd__inner">
      {%- if variant == 'bar' -%}<span class="bcd__live" aria-hidden="true"></span>{%- endif -%}
      {%- if msg != blank -%}<span class="bcd__msg">{{ msg }}</span>{%- endif -%}
      <span class="bcd__clock" aria-live="off">
        <span class="bcd__u"><b data-d>00</b><i>d</i></span>
        <span class="bcd__sep" aria-hidden="true">:</span>
        <span class="bcd__u"><b data-h>00</b><i>h</i></span>
        <span class="bcd__sep" aria-hidden="true">:</span>
        <span class="bcd__u"><b data-m>00</b><i>m</i></span>
        <span class="bcd__sep" aria-hidden="true">:</span>
        <span class="bcd__u"><b data-s>00</b><i>s</i></span>
      </span>
      {%- if cta_text != blank and cta_link != blank -%}
        <a class="bcd__cta" href="{{ cta_link }}">{{ cta_text }} <span aria-hidden="true">›</span></a>
      {%- endif -%}
    </div>
  </div>

  {%- style -%}
    .bcd { width: 100%; overflow: hidden; }
    .bcd__inner { display: flex; gap: 12px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .bcd__clock { display: inline-flex; gap: 6px; align-items: center; }
    .bcd__u { display: inline-flex; align-items: baseline; gap: 2px; }
    .bcd__u b { font-variant-numeric: tabular-nums; }
    .bcd__u i { font-style: normal; font-weight: 600; opacity: .8; font-size: .8em; }
    .bcd__sep { display: none; }

    /* ===== Barra do topo — modo Dia D (alta urgência) ===== */
    .bcd--bar {
      color: var(--bcd-fg);
      background: var(--bcd-bg);
      background-image: linear-gradient(100deg, #a60510 0%, var(--bcd-bg) 35%, #ff3b2e 50%, var(--bcd-bg) 65%, #a60510 100%);
      background-size: 250% 100%;
      animation: bcdShine 7s linear infinite;
      box-shadow: inset 0 -2px 0 rgba(0,0,0,.18);
    }
    .bcd--bar .bcd__inner { padding: 9px 14px; font-size: 13px; font-weight: 800; letter-spacing: .045em; text-transform: uppercase; line-height: 1; gap: 10px 14px; }
    .bcd--bar .bcd__msg { text-shadow: 0 1px 2px rgba(0,0,0,.22); }
    .bcd--bar .bcd__live { width: 9px; height: 9px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,.8); animation: bcdPulse 1.4s ease-out infinite; flex: 0 0 auto; }
    .bcd--bar .bcd__u b { background: rgba(0,0,0,.28); padding: 3px 6px; border-radius: 6px; min-width: 24px; text-align: center; display: inline-block; font-size: 14px; font-weight: 900; }
    .bcd--bar .bcd__u i { opacity: .85; margin-left: 1px; }
    .bcd--bar .bcd__cta { color: var(--bcd-bg); background: #fff; font-weight: 900; padding: 6px 14px; border-radius: 999px; text-decoration: none; letter-spacing: .04em; box-shadow: 0 3px 10px rgba(0,0,0,.22); white-space: nowrap; }
    .bcd--bar .bcd__cta:hover { transform: translateY(-1px); }

    /* ===== Hero (dentro do banner escuro do Dia D) ===== */
    .bcd--hero .bcd__inner { gap: 10px 8px; }
    .bcd--hero .bcd__msg { display: none; }
    .bcd--hero .bcd__u { flex-direction: column; align-items: center; gap: 3px; }
    .bcd--hero .bcd__u b { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(4px); color: #fff; padding: 10px 12px; border-radius: 12px; min-width: 54px; text-align: center; display: inline-block; font-size: clamp(22px, 4vw, 34px); font-weight: 900; line-height: 1; }
    .bcd--hero .bcd__u i { color: rgba(255,255,255,.72); font-size: 11px; text-transform: uppercase; letter-spacing: .12em; }
    .bcd--hero .bcd__sep { display: inline-block; color: rgba(255,255,255,.45); font-size: 24px; font-weight: 800; align-self: flex-start; margin-top: 6px; }

    /* ===== Página de produto ===== */
    .bcd--product { margin: 0 0 16px; }
    .bcd--product .bcd__inner { padding: 12px 14px; border: 1.5px solid var(--bcd-bg); border-radius: 14px; background: rgba(0,0,0,.02); }
    .bcd--product .bcd__msg { color: var(--bcd-bg); text-transform: uppercase; letter-spacing: .03em; font-size: 12.5px; font-weight: 800; }
    .bcd--product .bcd__clock b { background: var(--bcd-bg); color: var(--bcd-fg); padding: 5px 8px; border-radius: 8px; min-width: 30px; text-align: center; display: inline-block; font-weight: 800; }
    .bcd--product .bcd__u i { margin-left: 2px; opacity: .7; color: #555; }

    @keyframes bcdShine { 0% { background-position: 0% 50%; } 100% { background-position: 250% 50%; } }
    @keyframes bcdPulse { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,.7); } 70% { box-shadow: 0 0 0 8px rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }
    @media (prefers-reduced-motion: reduce) {
      .bcd--bar { animation: none; }
      .bcd--bar .bcd__live { animation: none; }
    }
    @media (max-width: 480px) {
      .bcd--bar .bcd__inner { font-size: 11px; gap: 7px 9px; padding: 7px 10px; }
      .bcd--bar .bcd__u b { font-size: 12.5px; min-width: 21px; padding: 2px 5px; }
      .bcd--bar .bcd__cta { padding: 5px 11px; font-size: 11px; }
      .bcd--product .bcd__msg { width: 100%; text-align: center; }
    }
  {%- endstyle -%}

  <script>
    (function () {
      if (window.__bcdInit) return;
      window.__bcdInit = true;
      function p(n){ return (n < 10 ? '0' : '') + n; }
      function tick(){
        var now = Date.now();
        var nodes = document.querySelectorAll('[data-botanika-countdown]');
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          var t = parseInt(el.getAttribute('data-countdown-target'), 10);
          if (!t) { continue; }
          var diff = t * 1000 - now;
          if (diff <= 0) {
            if (el.getAttribute('data-hide-done')) { el.style.display = 'none'; }
            else {
              var z = el.querySelectorAll('[data-d],[data-h],[data-m],[data-s]');
              for (var k = 0; k < z.length; k++) { z[k].textContent = '00'; }
            }
            continue;
          }
          var s = Math.floor(diff / 1000);
          var d = Math.floor(s / 86400); s -= d * 86400;
          var h = Math.floor(s / 3600); s -= h * 3600;
          var m = Math.floor(s / 60); s -= m * 60;
          var qd = el.querySelector('[data-d]'); if (qd) qd.textContent = p(d);
          var qh = el.querySelector('[data-h]'); if (qh) qh.textContent = p(h);
          var qm = el.querySelector('[data-m]'); if (qm) qm.textContent = p(m);
          var qs = el.querySelector('[data-s]'); if (qs) qs.textContent = p(s);
        }
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}
