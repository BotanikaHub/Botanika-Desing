{%- comment -%}
  Botão flutuante do WhatsApp (suporte / time de vendas).
  Editar número e mensagem abaixo.
{%- endcomment -%}
{%- liquid
  assign wa_number = '553172679362'
  assign wa_message = 'Olá, vim do site e gostaria de mais informações ou tirar dúvidas.'
  assign wa_text = wa_message | url_encode
  assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}
<a
  class="wa-float"
  href="{{ wa_href }}"
  target="_blank"
  rel="noopener nofollow"
  aria-label="Falar no WhatsApp"
>
  <span class="wa-float__pulse" aria-hidden="true"></span>
  <svg class="wa-float__icon" viewBox="0 0 32 32" width="32" height="32" fill="#fff" aria-hidden="true">
    <path d="M16.003 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.6 4.47 1.73 6.41L3.2 28.8l6.57-1.72a12.74 12.74 0 0 0 6.23 1.62h.01c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.33-6.63-3.75-9.05a12.7 12.7 0 0 0-9.06-3.65Zm0 23.31h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.02 1.05 1.07-3.92-.25-.4a10.6 10.6 0 0 1-1.63-5.66c0-5.87 4.78-10.65 10.65-10.65 2.85 0 5.52 1.11 7.53 3.12a10.6 10.6 0 0 1 3.12 7.53c0 5.87-4.78 10.65-10.65 10.65Zm5.85-7.98c-.32-.16-1.9-.94-2.2-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.89-1.78-2.21-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.66 0 1.57 1.14 3.08 1.3 3.3.16.21 2.25 3.43 5.44 4.81.76.33 1.35.52 1.81.67.76.24 1.46.21 2.01.13.61-.09 1.9-.78 2.17-1.53.27-.75.27-1.39.19-1.53-.08-.13-.29-.21-.61-.37Z"/>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 998;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25D366;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    transition: transform .18s ease, box-shadow .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-float:hover { transform: scale(1.06); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28); }
  .wa-float__icon { position: relative; z-index: 1; }
  .wa-float__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    opacity: .55;
    animation: wa-pulse 2.2s ease-out infinite;
  }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: .5; }
    70% { transform: scale(1.7); opacity: 0; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  @media (max-width: 749px) {
    .wa-float { width: 48px; height: 48px; right: 12px; bottom: 100px; }
    .wa-float__icon { width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float__pulse { animation: none; }
  }
</style>
