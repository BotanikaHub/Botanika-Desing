{%- comment -%}
  Retorna 'yes' se o produto faz parte da campanha (destaque ligado
  + handle na lista de Configurações do tema → "Campanha — destaque").
  Uso: {% render 'botanika-campaign-flag', product: card_product %}
{%- endcomment -%}
{%- liquid
  assign p = product
  assign on = settings.camp_active
  assign list = settings.camp_handles | default: '' | downcase | replace: ' ', '' | split: ','
  assign match = false
  if on and p != blank
    for h in list
      if h == p.handle
        assign match = true
        break
      endif
    endfor
  endif
  if match
    echo 'yes'
  endif
-%}
