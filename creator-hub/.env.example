# Copie para .env e preencha os valores.

# Banco Supabase (aba Connect → ORMs)
DATABASE_URL="postgresql://postgres.REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Chave das sessões (JWT). OBRIGATÓRIA em produção — o app não sobe sem ela.
# Gere uma string aleatória longa, ex.: `openssl rand -base64 48`.
SESSION_SECRET="gere-uma-string-aleatoria-longa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SHOPIFY_API_VERSION="2025-01"

# Admin criado/atualizado a cada deploy pelo scripts/bootstrap.mjs.
# Super admin (vê todas as marcas). Troque a senha após o primeiro acesso.
ADMIN_EMAIL="admin@creatorclub.com.br"
ADMIN_PASSWORD="defina-uma-senha-forte"

# E-mail transacional (opcional) — sem RESEND_API_KEY o envio é ignorado.
RESEND_API_KEY=""
# Domínio único verificado na Resend. Cada marca envia de <slug>@ESSE_DOMINIO
# automaticamente (ex.: botanika@creatorclub.com.br, vermfree@creatorclub.com.br).
EMAIL_BASE_DOMAIN="creatorclub.com.br"
# Remetente padrão, usado só se EMAIL_BASE_DOMAIN não estiver definido.
EMAIL_FROM="Creator Club <onboarding@resend.dev>"
