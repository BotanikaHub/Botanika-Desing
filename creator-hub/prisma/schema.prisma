// Botanika Creator Hub — hub de afiliados multi-marca (Botanika, VermeFree, ...)
// Banco: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Uma marca/operação (ex.: Botanika, VermeFree). Cada marca tem sua própria
/// loja Shopify, seus creators, cupons e painel — tudo isolado por marca.
model Brand {
  id       String  @id @default(cuid())
  slug     String  @unique // ex.: "botanika", "vermfree" (usado nas URLs)
  name     String
  tagline  String? // frase curta do programa

  // Aparência (tema do painel daquela marca)
  primaryColor String @default("#2f6b3f")
  logoUrl      String?

  // Remetente dos e-mails automáticos desta marca (isolado por empresa).
  // Ex.: "Botanika Creator Club <creators@botanikabrasil.com.br>".
  // Se nulo, cai no fallback EMAIL_FROM do ambiente.
  emailFrom String?

  // Loja Shopify da marca
  storeUrl   String? // domínio público, ex.: https://botanikabrasil.com.br
  shopDomain String? // domínio .myshopify.com

  // Conexão Shopify (OAuth) — preenchidos quando a loja é conectada
  shopifyApiKey      String? // Client ID do app no Dev Dashboard
  shopifyApiSecret   String? // Client Secret
  shopifyAccessToken String? // token offline obtido via OAuth
  shopifyScope       String?
  shopifyInstalledAt DateTime?

  // Comissão da creator (o que ela ganha — interno, nunca vai pra Shopify).
  defaultCommissionRate Float @default(0.15)
  // Desconto do cupom (o que o cliente ganha — aplicado na Shopify).
  defaultDiscountRate   Float @default(0.05)

  // Termo de aceite (aceite eletrônico no app). Editável pelo admin.
  termTitle   String?
  termBody    String? // texto do termo (aceito com 1 clique + registro)
  termVersion Int     @default(1) // sobe quando o texto muda

  // Gamificação (meta + bônus) — configurável, sem hardcode.
  goalPeriod        String @default("monthly") // "monthly" | "all"
  goalDefaultAmount Float  @default(3000) // meta padrão da marca (R$)
  bonusStepAmount   Float  @default(1000) // a cada X além da meta = 1 bônus
  bonusLabel        String @default("bônus") // o que a creator ganha (ex.: "suplemento extra")

  creators Creator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Administradores (equipe da empresa). Se brandId for nulo, é super admin
/// e enxerga todas as marcas; se preenchido, fica restrito àquela marca.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  brandId      String?
  createdAt    DateTime @default(now())
}

/// Conta única da influencer (login unificado). Agrupa as participações dela
/// em cada marca (um Creator por marca). Assim ela entra num app só e vê os
/// dados separados por empresa + um consolidado.
model CreatorAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  creators     Creator[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Um creator/afiliado, sempre vinculado a uma marca (e a uma conta unificada).
model Creator {
  id      String        @id @default(cuid())
  brand   Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId String
  status  CreatorStatus @default(PENDING)

  account   CreatorAccount? @relation(fields: [accountId], references: [id])
  accountId String?

  // Acesso
  email        String
  passwordHash String
  name         String

  // Dados do cadastro
  phone         String?
  instagram     String?
  tiktok        String?
  followers     Int?
  niche         String?
  city          String?
  pitch         String?
  profession    String? // médico, nutricionista, influenciador, etc.
  desiredCoupon String?

  // Atribuídos na aprovação. Único POR MARCA (a mesma influencer pode ter o
  // mesmo cupom em marcas diferentes, cada um na sua loja).
  couponCode     String?
  // % que a creator ganha por venda (interno). Padrão 15%.
  commissionRate Float   @default(0.15)
  // % de desconto do cupom para o cliente (espelha o valor na Shopify).
  // Nulo = desconto não gerenciado por aqui (ex.: cupom importado antigo).
  couponDiscountRate Float?
  // Configuração completa do cupom na Shopify (tipo de valor, onde aplica,
  // produtos/coleções, frete grátis, mínimos e limites). Espelho do que foi
  // salvo por aqui. Nulo = ainda não configurado pelo painel.
  couponConfig Json?

  // Importado da Shopify e ainda não reivindicado por uma influencer.
  // false = sem login utilizável (aguardando a influencer criar acesso).
  claimed Boolean @default(true)
  source  String  @default("signup") // "signup" | "shopify_import"

  shopifyPriceRuleId String?
  shopifyDiscountId  String?

  // Meta de vendas individual (override). Nulo = usa o padrão da marca.
  goalAmount Float?

  // Termo de aceite (aceite eletrônico) + dados para contrato/envio.
  termsAcceptedAt DateTime?
  termsVersion    Int?
  termsName       String? // nome como confirmado no aceite
  termsCpf        String?
  termsIp         String?

  // Endereço de envio (preenchido no aceite; usado na lista de envio).
  shipCep        String?
  shipStreet     String?
  shipNumber     String?
  shipComplement String?
  shipDistrict   String?
  shipCity       String?
  shipState      String?

  // Ficha / cadastro completo (dados pessoais e de contrato).
  cpf           String? // CPF (contrato/pagamento)
  pixKey        String? // Chave PIX (pagamento/saque)
  birthDate     String? // data de nascimento (yyyy-mm-dd)
  contractStart String? // início da parceria/contrato (yyyy-mm-dd)
  contractEnd   String? // fim da vigência do contrato (yyyy-mm-dd)
  notes         String? // observação — campo livre interno (admin)

  // Checklist interno (admin) — sim/não.
  followsInstagram Boolean @default(false) // "Seguimos no Instagram?"
  inGroup          Boolean @default(false) // "Está no grupo?"
  contractSigned   Boolean @default(false) // contrato assinado
  tagged           Boolean @default(false) // "Etiquetada"

  // Entrou na lista de envio ativa (aprovado + termo assinado). Admin pode
  // alternar manualmente se precisar tirar/colocar alguém.
  shippingActive Boolean @default(false)

  rejectionReason String?

  clicks Click[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Um e-mail é único dentro de cada marca (a mesma pessoa pode ser afiliada
  // das duas marcas com o mesmo e-mail).
  @@unique([brandId, email])
  @@unique([brandId, couponCode])
  @@index([brandId, status])
  @@index([accountId])
}

/// Clique num link de afiliado (para métrica de cliques).
model Click {
  id        String   @id @default(cuid())
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  ip        String?
  userAgent String?
  referrer  String?
  landing   String?
  createdAt DateTime @default(now())

  @@index([creatorId])
}
