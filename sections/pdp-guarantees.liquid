{%- comment -%}
  ============================================================
  Faixa de garantias / compra segura (estilo Vhita).
  Ícones + reasseguros. Opcional: nota da loja + selo Site Seguro.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign items = section.blocks
-%}
<div class="section pdp-guar-wrap">
  <div class="container">
    {%- if st.heading != blank -%}
      <h3 class="pdp-guar__title">{{ st.heading }}</h3>
    {%- endif -%}

    {%- if st.show_rating -%}
      <div class="pdp-guar__rating">
        <span class="pdp-guar__stars" aria-hidden="true">★★★★★</span>
        {%- if st.rating_score != blank -%}<strong class="pdp-guar__score">{{ st.rating_score }}</strong>{%- endif -%}
        {%- if st.rating_text != blank -%}<span class="pdp-guar__rtext">{{ st.rating_text }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if items.size > 0 -%}
      <div class="pdp-guar__grid">
        {%- for item in items -%}
          <div class="pdp-guar__item" {{ item.shopify_attributes }}>
            <span class="pdp-guar__icon">{{ item.settings.icon }}</span>
            <span class="pdp-guar__text">{{ item.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if st.show_seal and st.seal_file != blank -%}
      <div class="pdp-guar__seal">
        <img src="data:image/jpeg;base64," alt="Site seguro" decoding="async" width="150">
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .pdp-guar-wrap { padding: 18px 0; }
  .pdp-guar__title { text-align: center; margin: 0 0 14px; font-size: clamp(18px, 2.4vw, 24px); }
  .pdp-guar__rating { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 16px; font-size: 15px; }
  .pdp-guar__stars { color: #f5a623; letter-spacing: 1px; font-size: 17px; }
  .pdp-guar__score { font-size: 17px; }
  .pdp-guar__rtext { opacity: .8; }
  .pdp-guar__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; max-width: 900px; margin: 0 auto; }
  .pdp-guar__item {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
    padding: 16px 8px; border: 1px solid #eee; border-radius: 14px; background: #fcfcfc;
  }
  .pdp-guar__icon { font-size: 24px; line-height: 1; }
  .pdp-guar__text { font-size: 12.5px; font-weight: 600; line-height: 1.25; }
  .pdp-guar__seal { text-align: center; margin-top: 16px; }
  @media (max-width: 749px) {
    .pdp-guar__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Garantias / Compra segura",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Marca segura. Compra segura." },
    { "type": "header", "content": "Nota da loja (opcional)" },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar nota da loja", "default": true },
    { "type": "text", "id": "rating_score", "label": "Nota (ex: 4.9/5)", "default": "4.9/5" },
    { "type": "text", "id": "rating_text", "label": "Texto", "default": "milhares de clientes satisfeitos" },
    { "type": "header", "content": "Selo (opcional)" },
    { "type": "checkbox", "id": "show_seal", "label": "Mostrar selo Site Seguro", "default": true },
    { "type": "text", "id": "seal_file", "label": "Arquivo do selo em assets", "default": "selo-site-seguro.png" }
  ],
  "blocks": [
    {
      "type": "guar",
      "name": "Garantia",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícone (emoji)", "default": "🔒" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Protegemos seus dados" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Garantias / Compra segura",
      "blocks": [
        { "type": "guar", "settings": { "icon": "🔒", "text": "Protegemos seus dados" } },
        { "type": "guar", "settings": { "icon": "📦", "text": "Entrega garantida" } },
        { "type": "guar", "settings": { "icon": "🧾", "text": "Emitimos Nota Fiscal" } },
        { "type": "guar", "settings": { "icon": "✅", "text": "Loja oficial Botanika" } },
        { "type": "guar", "settings": { "icon": "↩️", "text": "Reembolso garantido em 7 dias" } }
      ]
    }
  ]
}
{% endschema %}
