{%- comment -%}
  ============================================================
  Banner Curadoria — Dr. William Araujo (desktop + mobile).
  Imagem por SELETOR (image_picker) OU nome do arquivo em assets (fallback).
  Banner inteiro clicável.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign has_desktop = false
  if st.image_desktop != blank or st.file_desktop != blank
    assign has_desktop = true
  endif
-%}
{%- if has_desktop -%}
  <div class="curadoria-banner curadoria-banner--{{ st.section_width }}{% if st.rounded %} curadoria-banner--rounded{% endif %}" id="curadoria-{{ section.id }}">
    {%- if st.link != blank -%}<a class="curadoria-banner__link" href="{{ st.link }}" aria-label="{{ st.alt | escape }}">{%- endif -%}
      <picture>
        {%- if st.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ st.image_mobile | image_url: width: 1080 }}">
        {%- elsif st.file_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ st.file_mobile | asset_url }}">
        {%- endif -%}
        {%- if st.image_desktop != blank -%}
          <img class="curadoria-banner__img" src="{{ st.image_desktop | image_url: width: 1600 }}" srcset="{{ st.image_desktop | image_url: width: 1024 }} 1024w, {{ st.image_desktop | image_url: width: 1600 }} 1600w, {{ st.image_desktop | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img class="curadoria-banner__img" src="{{ st.file_desktop | asset_url }}" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
      </picture>
    {%- if st.link != blank -%}</a>{%- endif -%}
  </div>

  {%- style -%}
    #shopify-section-{{ section.id }} { --curadoria-max: {{ settings.page_width | default: 1280 }}px; }
    .curadoria-banner { width: 100%; overflow: hidden; line-height: 0; }
    .curadoria-banner--container { max-width: var(--curadoria-max); margin-inline: auto; padding-inline: 15px; }
    .curadoria-banner--rounded .curadoria-banner__img { border-radius: 16px; }
    .curadoria-banner__link { display: block; }
    .curadoria-banner__img {
      display: block; width: 100%; height: 100%; object-fit: cover;
      aspect-ratio: 1376 / 768;
    }
    @media (max-width: 749px) {
      .curadoria-banner__img { aspect-ratio: 900 / 1200; }
      .curadoria-banner--rounded .curadoria-banner__img { border-radius: 12px; }
    }
  {%- endstyle -%}
{%- else -%}
  {%- if request.design_mode -%}
    <div style="padding:40px;text-align:center;background:#f3f3f3;color:#333;">
      Selecione a imagem do banner (Curadoria Dr. William) nos ajustes desta seção.
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Banner Curadoria (Dr. William)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagem desktop (clique para trocar)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagem mobile (clique para trocar)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do banner"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Texto alternativo (alt)",
      "default": "Curadoria do Dr. William Araujo - Suplementação com assinatura médica"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largura",
      "options": [
        { "value": "full", "label": "Tela cheia" },
        { "value": "container", "label": "Contido (com margem)" }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "label": "Cantos arredondados",
      "default": false
    },
    {
      "type": "header",
      "content": "Avançado (fallback por arquivo em assets)"
    },
    {
      "type": "text",
      "id": "file_desktop",
      "label": "Arquivo desktop em assets",
      "info": "Usado só se o seletor de imagem desktop estiver vazio.",
      "default": "dr-william-desktop.png"
    },
    {
      "type": "text",
      "id": "file_mobile",
      "label": "Arquivo mobile em assets",
      "info": "Usado só se o seletor de imagem mobile estiver vazio.",
      "default": "dr-william-mobile.png"
    }
  ],
  "presets": [
    {
      "name": "Banner Curadoria (Dr. William)"
    }
  ]
}
{% endschema %}
