{%- comment -%}
  ============================================================
  Banner Curadoria — Dr. William Araujo (home).
  Imagem embutida (base64) para renderizar sempre, sem
  depender de upload de asset. Para trocar a imagem, gere o
  banner novamente e substitua este arquivo.
  ============================================================
{%- endcomment -%}
<div class="drw-banner">
  <picture>
    <source media="(max-width: 749px)" srcset="data:image/jpeg;base64,">
    <img
      class="drw-banner__img"
      src="data:image/jpeg;base64,"
      alt="Curadoria do Dr. William Araujo — Suplementacao com assinatura medica"
      width="1280" height="714"
      decoding="async">
  </picture>
</div>

{%- style -%}
  .drw-banner { width: 100%; line-height: 0; }
  .drw-banner__img { display: block; width: 100%; height: auto; }
{%- endstyle -%}

{% schema %}
{
  "name": "Banner Dr. William",
  "settings": [],
  "presets": [
    { "name": "Banner Dr. William" }
  ]
}
{% endschema %}
