{%- comment -%}
  ============================================================
  "Especialistas que confiam na Botanika" (estilo Vhita).
  Cards com foto + nome + credencial + descrição + @.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign experts = section.blocks
-%}
{%- if experts.size > 0 -%}
  <div class="section esp-wrap color-{{ st.color_scheme }} gradient">
    <div class="container">
      {%- if st.heading != blank -%}<h2 class="esp__title">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.subheading != blank -%}<p class="esp__sub">{{ st.subheading }}</p>{%- endif -%}
      <div class="esp__grid" style="--cols: {{ st.columns }};">
        {%- for e in experts -%}
          {%- assign es = e.settings -%}
          <div class="esp__card" {{ e.shopify_attributes }}>
            {%- if es.photo != blank -%}
              <div class="esp__photo">{{ es.photo | image_url: width: 500 | image_tag: loading: 'lazy', alt: es.name, class: 'esp__img' }}</div>
            {%- else -%}
              <div class="esp__photo esp__photo--ph"></div>
            {%- endif -%}
            <div class="esp__info">
              {%- if es.name != blank -%}<h3 class="esp__name">{{ es.name }}</h3>{%- endif -%}
              {%- if es.description != blank -%}<div class="esp__desc">{{ es.description }}</div>{%- endif -%}
              {%- if es.credential != blank -%}<div class="esp__cred">{{ es.credential }}</div>{%- endif -%}
              {%- if es.handle != blank -%}
                <a class="esp__handle" href="{{ es.handle_link | default: '#' }}"{% if es.handle_link != blank %} target="_blank" rel="noopener"{% endif %}>{{ es.handle }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- style -%}
    .esp-wrap { padding: 40px 0; }
    .esp__title { text-align: center; margin: 0 0 6px; font-size: clamp(24px, 3.2vw, 34px); }
    .esp__sub { text-align: center; opacity: .8; margin: 0 0 28px; }
    .esp__grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 22px; }
    .esp__card { background: #fff; border: 1px solid #eee; border-radius: 18px; overflow: hidden; }
    .esp__photo { aspect-ratio: 1 / 1; overflow: hidden; background: #f3f3f3; }
    .esp__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .esp__info { padding: 18px; }
    .esp__name { margin: 0 0 8px; font-size: 18px; color: {{ st.name_color | default: '#303890' }}; }
    .esp__desc { font-size: 13.5px; line-height: 1.5; opacity: .85; }
    .esp__cred { font-size: 13.5px; font-weight: 700; margin-top: 8px; }
    .esp__handle { display: inline-block; margin-top: 12px; padding: 6px 14px; border-radius: 999px; background: {{ st.name_color | default: '#303890' }}; color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; }
    @media (max-width: 900px) { .esp__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .esp__grid { grid-template-columns: 1fr; } }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Especialistas",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cor", "default": "default" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Especialistas que confiam na Botanika" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Ciência e curadoria médica em cada fórmula" },
    { "type": "range", "id": "columns", "label": "Colunas (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "name_color", "label": "Cor do nome/botão", "default": "#303890" }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Especialista",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto" },
        { "type": "text", "id": "name", "label": "Nome", "default": "Dr. William Araujo" },
        { "type": "richtext", "id": "description", "label": "Descrição", "default": "<p>Responsável pela curadoria médica das fórmulas Botanika — dose certa e rótulo transparente.</p>" },
        { "type": "text", "id": "credential", "label": "Credencial", "default": "CRM 76.962 · Curadoria médica" },
        { "type": "text", "id": "handle", "label": "@ (Instagram)", "default": "" },
        { "type": "url", "id": "handle_link", "label": "Link do @" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Especialistas",
      "blocks": [
        { "type": "expert", "settings": { "name": "Dr. William Araujo", "credential": "CRM 76.962 · Curadoria médica" } }
      ]
    }
  ]
}
{% endschema %}
