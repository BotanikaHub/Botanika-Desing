{%- comment -%}
  ============================================================
  DIA D BOTANIKA — Hero/slideshow.
  Cada slide aceita imagem por SELETOR (image_picker) OU, como fallback,
  pelo nome do arquivo na pasta assets/. O seletor sobrepõe o arquivo.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign has1 = false
  assign has2 = false
  if st.s1_image != blank or st.s1_desktop != blank
    assign has1 = true
  endif
  if st.s2_image != blank or st.s2_desktop != blank
    assign has2 = true
  endif
  assign count = 0
  if has1
    assign count = count | plus: 1
  endif
  if has2
    assign count = count | plus: 1
  endif
-%}
{%- if count > 0 -%}
  <dia-d-hero
    class="diad-hero"
    id="diad-hero-{{ section.id }}"
    data-autoplay="{{ st.autoplay }}"
    data-speed="{{ st.speed }}"
  >
    <div class="diad-hero__track">
      {%- if has1 -%}
        <div class="diad-hero__slide is-active" data-index="0">
          {%- if st.s1_link != blank -%}<a class="diad-hero__link" href="{{ st.s1_link }}">{%- endif -%}
          <picture>
            {%- if st.s1_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ st.s1_image_mobile | image_url: width: 1080 }}">
            {%- elsif st.s1_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ st.s1_mobile | asset_url }}">
            {%- endif -%}
            {%- if st.s1_image != blank -%}
              <img class="diad-hero__img" src="{{ st.s1_image | image_url: width: 1600 }}" srcset="{{ st.s1_image | image_url: width: 1024 }} 1024w, {{ st.s1_image | image_url: width: 1600 }} 1600w, {{ st.s1_image | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ st.alt | escape }}" fetchpriority="high" decoding="async">
            {%- else -%}
              <img class="diad-hero__img" src="{{ st.s1_desktop | asset_url }}" alt="{{ st.alt | escape }}" fetchpriority="high" decoding="async">
            {%- endif -%}
          </picture>
          {%- if st.s1_link != blank -%}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if has2 -%}
        <div class="diad-hero__slide{% unless has1 %} is-active{% endunless %}" data-index="1">
          {%- if st.s2_link != blank -%}<a class="diad-hero__link" href="{{ st.s2_link }}">{%- endif -%}
          <picture>
            {%- if st.s2_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ st.s2_image_mobile | image_url: width: 1080 }}">
            {%- elsif st.s2_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ st.s2_mobile | asset_url }}">
            {%- endif -%}
            {%- if st.s2_image != blank -%}
              <img class="diad-hero__img" src="{{ st.s2_image | image_url: width: 1600 }}" srcset="{{ st.s2_image | image_url: width: 1024 }} 1024w, {{ st.s2_image | image_url: width: 1600 }} 1600w, {{ st.s2_image | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img class="diad-hero__img" src="{{ st.s2_desktop | asset_url }}" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
          </picture>
          {%- if st.s2_link != blank -%}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if count > 1 -%}
      <div class="diad-hero__dots">
        <button type="button" class="diad-hero__dot is-active" data-goto="0" aria-label="Slide 1"></button>
        <button type="button" class="diad-hero__dot" data-goto="1" aria-label="Slide 2"></button>
      </div>
    {%- endif -%}
  </dia-d-hero>

  {%- style -%}
    .diad-hero { display: block; position: relative; width: 100%; overflow: hidden; background: {{ st.bg_fallback | default: '#12183a' }}; }
    .diad-hero__track { position: relative; width: 100%; }
    .diad-hero__slide {
      position: absolute; inset: 0; opacity: 0; transition: opacity .6s ease;
      pointer-events: none; aspect-ratio: 1376 / 768;
    }
    .diad-hero__slide.is-active { position: relative; opacity: 1; pointer-events: auto; z-index: 1; }
    .diad-hero__link { display: block; width: 100%; height: 100%; }
    .diad-hero__img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .diad-hero__dots {
      position: absolute; left: 0; right: 0; bottom: 14px;
      display: flex; gap: 8px; justify-content: center; z-index: 2;
    }
    .diad-hero__dot {
      width: 9px; height: 9px; border-radius: 50%; border: none; cursor: pointer;
      background: rgba(255,255,255,.55); padding: 0; transition: background .2s, transform .2s;
    }
    .diad-hero__dot.is-active { background: #fff; transform: scale(1.2); }
    @media (max-width: 749px) {
      .diad-hero__slide { aspect-ratio: 900 / 1200; }
      .diad-hero__dots { bottom: 10px; }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var root = document.getElementById('diad-hero-{{ section.id }}');
      if (!root || root.dataset.diadInit === '1') return;
      root.dataset.diadInit = '1';
      var slides = Array.prototype.slice.call(root.querySelectorAll('.diad-hero__slide'));
      var dots = Array.prototype.slice.call(root.querySelectorAll('.diad-hero__dot'));
      if (slides.length < 2) return;
      var i = 0, timer = null;
      var speed = (parseInt(root.dataset.speed, 10) || 5) * 1000;
      var autoplay = root.dataset.autoplay === 'true';

      function show(n) {
        slides[i].classList.remove('is-active');
        if (dots[i]) dots[i].classList.remove('is-active');
        i = (n + slides.length) % slides.length;
        slides[i].classList.add('is-active');
        if (dots[i]) dots[i].classList.add('is-active');
      }
      function next() { show(i + 1); }
      function start() { if (autoplay) { stop(); timer = setInterval(next, speed); } }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          show(parseInt(d.dataset.goto, 10) || 0);
          start();
        });
      });
      start();
    })();
  </script>
{%- else -%}
  {%- if request.design_mode -%}
    <div style="padding:40px;text-align:center;background:#f3f3f3;color:#333;">
      Selecione as imagens do Dia D Hero nos ajustes desta seção.
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Dia D — Hero (banners)",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotação automática",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Trocar a cada",
      "default": 5
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Texto alternativo (alt)",
      "default": "Dia D Botanika - 8% OFF em todo o site"
    },
    {
      "type": "color",
      "id": "bg_fallback",
      "label": "Cor de fundo (enquanto carrega)",
      "default": "#12183a"
    },
    {
      "type": "header",
      "content": "Slide 1"
    },
    {
      "type": "image_picker",
      "id": "s1_image",
      "label": "Imagem desktop (clique para trocar)"
    },
    {
      "type": "image_picker",
      "id": "s1_image_mobile",
      "label": "Imagem mobile (clique para trocar)"
    },
    {
      "type": "url",
      "id": "s1_link",
      "label": "Link do slide 1",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "s1_desktop",
      "label": "Avançado: arquivo desktop em assets",
      "info": "Só usado se o seletor de imagem desktop acima estiver vazio.",
      "default": "diad-banner-1-desktop.jpg"
    },
    {
      "type": "text",
      "id": "s1_mobile",
      "label": "Avançado: arquivo mobile em assets",
      "info": "Só usado se o seletor de imagem mobile acima estiver vazio.",
      "default": "diad-banner-1-mobile.jpg"
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "s2_image",
      "label": "Imagem desktop (clique para trocar)"
    },
    {
      "type": "image_picker",
      "id": "s2_image_mobile",
      "label": "Imagem mobile (clique para trocar)"
    },
    {
      "type": "url",
      "id": "s2_link",
      "label": "Link do slide 2",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "s2_desktop",
      "label": "Avançado: arquivo desktop em assets",
      "info": "Só usado se o seletor de imagem desktop acima estiver vazio.",
      "default": "diad-banner-2-desktop.jpg"
    },
    {
      "type": "text",
      "id": "s2_mobile",
      "label": "Avançado: arquivo mobile em assets",
      "info": "Só usado se o seletor de imagem mobile acima estiver vazio.",
      "default": "diad-banner-2-mobile.jpg"
    }
  ],
  "presets": [
    {
      "name": "Dia D — Hero (banners)"
    }
  ]
}
{% endschema %}
