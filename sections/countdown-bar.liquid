{%- comment -%}
  Barra de contador regressivo no topo do site (acima das demais barras).
  Data-limite/cores vêm das Configurações do tema → "Contador de oferta".
{%- endcomment -%}
{%- if section.settings.show -%}
  {%- render 'botanika-countdown', variant: 'bar', message: section.settings.message, bg: section.settings.bg_color, fg: section.settings.text_color -%}
{%- endif -%}
{% schema %}
{
  "name": "Barra de contador",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Mostrar barra", "default": true },
    { "type": "text", "id": "message", "label": "Mensagem", "default": "🔥 Oferta de fim de semana termina em" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo da barra", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#000000" }
  ],
  "presets": [
    { "name": "Barra de contador" }
  ]
}
{% endschema %}
