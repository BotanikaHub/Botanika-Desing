{%- comment -%}
  ============================================================
  Banner promocional no topo da página de produto.
  Ex: "Quanto mais você compra, mais você ganha".
  Imagem por SELETOR (image_picker) OU nome do arquivo em assets (fallback).
  Altura natural (a proporção da imagem define a altura) — sem corte.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign has_img = false
  if st.image_desktop != blank or st.file_desktop != blank
    assign has_img = true
  endif
-%}
{%- if has_img -%}
  <div class="pdp-promo pdp-promo--{{ st.section_width }}{% if st.rounded %} pdp-promo--rounded{% endif %}">
    {%- if st.link != blank -%}<a class="pdp-promo__link" href="{{ st.link }}" aria-label="{{ st.alt | escape }}">{%- endif -%}
      <picture>
        {%- if st.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ st.image_mobile | image_url: width: 1200 }}">
        {%- elsif st.file_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ st.file_mobile | asset_url }}">
        {%- endif -%}
        {%- if st.image_desktop != blank -%}
          <img class="pdp-promo__img" src="{{ st.image_desktop | image_url: width: 1800 }}" srcset="{{ st.image_desktop | image_url: width: 1024 }} 1024w, {{ st.image_desktop | image_url: width: 1800 }} 1800w" sizes="100vw" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img class="pdp-promo__img" src="{{ st.file_desktop | asset_url }}" alt="{{ st.alt | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
      </picture>
    {%- if st.link != blank -%}</a>{%- endif -%}
  </div>

  {%- style -%}
    #shopify-section-{{ section.id }} { --pdp-promo-max: {{ settings.page_width | default: 1280 }}px; }
    .pdp-promo { width: 100%; line-height: 0; margin-bottom: 16px; }
    .pdp-promo--container { max-width: var(--pdp-promo-max); margin-inline: auto; padding-inline: 15px; }
    .pdp-promo__link { display: block; }
    .pdp-promo__img { display: block; width: 100%; height: auto; }
    .pdp-promo--rounded .pdp-promo__img { border-radius: 14px; }
  {%- endstyle -%}
{%- else -%}
  {%- if request.design_mode -%}
    <div style="padding:24px;text-align:center;background:#f3f3f3;color:#333;border-radius:8px;">
      Banner do topo do produto — selecione a imagem desktop e mobile nos ajustes desta seção.
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Banner topo do produto",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Imagem desktop (clique para trocar)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile (clique para trocar)" },
    { "type": "url", "id": "link", "label": "Link (opcional)" },
    { "type": "text", "id": "alt", "label": "Texto alternativo (alt)", "default": "Compre mais e ganhe mais desconto" },
    {
      "type": "select", "id": "section_width", "label": "Largura",
      "options": [ { "value": "full", "label": "Tela cheia" }, { "value": "container", "label": "Contido (com margem)" } ],
      "default": "container"
    },
    { "type": "checkbox", "id": "rounded", "label": "Cantos arredondados", "default": true },
    { "type": "header", "content": "Avançado (fallback por arquivo em assets)" },
    { "type": "text", "id": "file_desktop", "label": "Arquivo desktop em assets", "info": "Usado só se o seletor de imagem desktop estiver vazio." },
    { "type": "text", "id": "file_mobile", "label": "Arquivo mobile em assets" }
  ],
  "presets": [ { "name": "Banner topo do produto" } ]
}
{% endschema %}
