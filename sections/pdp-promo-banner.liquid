{%- comment -%}
  ============================================================
  Banner promocional no topo da página de produto.
  "Quanto mais você compra, mais você ganha."
  Imagem fixa nos assets do tema (desktop + mobile), sem
  configurações de schema para máxima compatibilidade.
  Trocar a imagem = substituir os arquivos em assets:
    pdp-ganhemais-desktop.png / pdp-ganhemais-mobile.png
  ============================================================
{%- endcomment -%}
<div class="pdp-promo">
  <picture>
    <source media="(max-width: 749px)" srcset="{{ 'pdp-ganhemais-mobile.png' | asset_url }}">
    <img
      class="pdp-promo__img"
      src="{{ 'pdp-ganhemais-desktop.png' | asset_url }}"
      alt="Quanto mais você compra, mais você ganha"
      loading="lazy"
      decoding="async">
  </picture>
</div>

{% stylesheet %}
  .pdp-promo { width: 100%; line-height: 0; margin-bottom: 16px; }
  .pdp-promo__img { display: block; width: 100%; height: auto; border-radius: 14px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner topo do produto",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [
    { "name": "Banner topo do produto" }
  ]
}
{% endschema %}
