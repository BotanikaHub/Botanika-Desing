{%- comment -%}
  ============================================================
  Banner promocional no topo da pagina de produto.
  Imagem embutida (base64). Alinhado a largura do conteudo
  da pagina (classe .container do tema).
  ============================================================
{%- endcomment -%}
{%- capture pp_fs_active -%}{%- render 'botanika-freeship-weekend', mode: 'active' -%}{%- endcapture -%}
{%- assign pp_fs_active = pp_fs_active | strip -%}
{%- assign pp_d = section.settings.image_desktop -%}
{%- assign pp_m = section.settings.image_mobile -%}
{%- if pp_fs_active == 'yes' and section.settings.image_desktop_promo != blank -%}
  {%- assign pp_d = section.settings.image_desktop_promo -%}
  {%- assign pp_m = section.settings.image_mobile_promo -%}
{%- endif -%}
<div class="pdp-promo container">
  {%- if section.settings.image_link != blank -%}<a href="{{ section.settings.image_link }}" aria-label="{{ section.settings.image_alt | default: 'Promoção' | escape }}">{%- endif -%}
  {%- if pp_d != blank -%}
    <picture>
      {%- if pp_m != blank -%}<source media="(max-width: 749px)" srcset="{{ pp_m | image_url: width: 1200 }}">{%- endif -%}
      <img class="pdp-promo__img" src="{{ pp_d | image_url: width: 1600 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" decoding="async">
    </picture>
  {%- else -%}
  <picture>
    <source media="(max-width: 749px)" srcset="data:image/jpeg;base64,">
    <img
      class="pdp-promo__img"
      src="data:image/jpeg;base64,"
      alt="Quanto mais voce compra, mais voce ganha"
      width="1600" height="260"
      decoding="async">
  </picture>
  {%- endif -%}
  {%- if section.settings.image_link != blank -%}</a>{%- endif -%}
</div>

{%- style -%}
  .pdp-promo { margin: 0 auto 24px; }
  .pdp-promo picture { position: static; display: block; font-size: 0; line-height: 0; }
  .pdp-promo__img { display: block; width: 100%; height: auto; border-radius: 14px; }
  @media (max-width: 749px) { .pdp-promo { margin-bottom: 16px; } }
{%- endstyle -%}

{% schema %}
{
  "name": "Banner topo do produto",
  "settings": [
    { "type": "header", "content": "Imagem padrão" },
    { "type": "paragraph", "content": "Se ficar vazio, usa a imagem embutida atual. Recomendado 1600×260 px (desktop) e 1080×520 px (mobile)." },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagem (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem (mobile)" },
    { "type": "header", "content": "Imagem promocional (fim de semana)" },
    { "type": "paragraph", "content": "Aparece automaticamente nos sábados/domingos quando a promo de frete estiver ligada (Config. do tema). Deixe vazio para não usar." },
    { "type": "image_picker", "id": "image_desktop_promo", "label": "Imagem promo (desktop)" },
    { "type": "image_picker", "id": "image_mobile_promo", "label": "Imagem promo (mobile)" },
    { "type": "header", "content": "Geral" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Quanto mais você compra, mais você ganha" },
    { "type": "url", "id": "image_link", "label": "Link ao clicar (opcional)" }
  ],
  "presets": [ { "name": "Banner topo do produto" } ]
}
{% endschema %}
