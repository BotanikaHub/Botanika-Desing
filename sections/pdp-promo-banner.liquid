{%- comment -%}
  ============================================================
  Banner promocional no topo da pagina de produto.
  "Quanto mais voce compra, mais voce ganha."
  Imagem embutida (base64) para renderizar sempre.
  ============================================================
{%- endcomment -%}
<div class="pdp-promo">
  <picture>
    <source media="(max-width: 749px)" srcset="data:image/jpeg;base64,">
    <img
      class="pdp-promo__img"
      src="data:image/jpeg;base64,"
      alt="Quanto mais voce compra, mais voce ganha"
      width="1600" height="260"
      decoding="async">
  </picture>
</div>

{%- style -%}
  .pdp-promo { width: 100%; max-width: 1040px; margin: 0 auto 24px; padding-inline: 15px; }
  .pdp-promo picture { display: block; font-size: 0; line-height: 0; }
  .pdp-promo__img { display: block; width: 100%; height: auto; border-radius: 14px; }
  @media (max-width: 749px) {
    .pdp-promo { max-width: 520px; margin-bottom: 16px; padding-inline: 12px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Banner topo do produto",
  "settings": [],
  "presets": [
    { "name": "Banner topo do produto" }
  ]
}
{% endschema %}
