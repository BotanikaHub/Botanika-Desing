{%- comment -%}
  ============================================================
  DIA D BOTANIKA — Barra de urgência no topo com timer 24h
  Evento: 07/07 — 8% OFF em todo o site (desconto automático no carrinho)
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign show = true
  if st.homepage_only and request.page_type != 'index'
    assign show = false
  endif
-%}
{%- if show -%}
  <div
    class="diad-bar section-diad-bar{% if st.hide_mobile %} diad-bar--desk-only{% endif %}"
    id="diad-bar-{{ section.id }}"
    data-diad-deadline="{{ st.deadline }}"
    style="--diad-bg:{{ st.bg_color }};--diad-bg2:{{ st.bg_color_2 }};--diad-text:{{ st.text_color }};--diad-accent:{{ st.accent_color }};"
  >
    {%- if st.cta_link != blank -%}
      <a class="diad-bar__link" href="{{ st.cta_link }}" aria-label="{{ st.message | strip_html }}">
    {%- else -%}
      <div class="diad-bar__link">
    {%- endif -%}
      <span class="diad-bar__fire" aria-hidden="true">🔥</span>
      <span class="diad-bar__msg">{{ st.message }}</span>
      <span class="diad-bar__timer">
        <span class="diad-bar__timer-label">{{ st.timer_label }}</span>
        <span class="diad-bar__clock" data-diad-clock>--:--:--</span>
      </span>
      {%- if st.cta_label != blank and st.cta_link != blank -%}
        <span class="diad-bar__cta">{{ st.cta_label }}</span>
      {%- endif -%}
      <span class="diad-bar__fire" aria-hidden="true">🔥</span>
    {%- if st.cta_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </div>

  {%- style -%}
    .diad-bar {
      background: linear-gradient(100deg, var(--diad-bg) 0%, var(--diad-bg2) 100%);
      color: var(--diad-text);
      font-family: inherit;
      position: relative;
      overflow: hidden;
    }
    .diad-bar__link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 9px 18px;
      text-decoration: none;
      color: inherit;
      line-height: 1.2;
    }
    .diad-bar__fire {
      font-size: 17px;
      animation: diadBarFlame 1.4s ease-in-out infinite;
    }
    @keyframes diadBarFlame {
      0%, 100% { transform: scale(1) rotate(-4deg); }
      50% { transform: scale(1.15) rotate(4deg); }
    }
    .diad-bar__msg {
      font-size: 13.5px;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .diad-bar__msg strong { font-weight: 800; color: var(--diad-accent); }
    .diad-bar__timer {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
    }
    .diad-bar__timer-label {
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.8;
      font-weight: 600;
    }
    .diad-bar__clock {
      font-size: 15px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      color: var(--diad-accent);
      background: rgba(0, 0, 0, 0.18);
      padding: 2px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    .diad-bar__cta {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      background: var(--diad-accent);
      color: var(--diad-bg);
      padding: 5px 12px;
      border-radius: 999px;
    }
    .diad-bar__link:hover .diad-bar__cta { filter: brightness(1.06); }
    @media (max-width: 749px) {
      .diad-bar--desk-only { display: none; }
      .diad-bar__link { gap: 8px; padding: 8px 12px; }
      .diad-bar__msg { font-size: 12px; }
      .diad-bar__clock { font-size: 13.5px; }
      .diad-bar__cta { display: none; }
      .diad-bar__fire:last-child { display: none; }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var bar = document.getElementById('diad-bar-{{ section.id }}');
      if (!bar || bar.dataset.diadInit === '1') return;
      bar.dataset.diadInit = '1';
      var clock = bar.querySelector('[data-diad-clock]');
      var deadline = new Date(bar.getAttribute('data-diad-deadline')).getTime();
      if (!clock || isNaN(deadline)) return;
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      var timer;
      function tick() {
        var diff = deadline - Date.now();
        if (diff <= 0) {
          clock.textContent = '00:00:00';
          clearInterval(timer);
          return;
        }
        var t = Math.floor(diff / 1000);
        var d = Math.floor(t / 86400);
        var h = Math.floor((t % 86400) / 3600);
        var m = Math.floor((t % 3600) / 60);
        var s = t % 60;
        clock.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
      }
      tick();
      timer = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Dia D — Barra de urgência",
  "class": "section-diad-bar-wrapper",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "message",
      "label": "Mensagem",
      "default": "DIA D BOTANIKA — <strong>8% OFF</strong> em todo o site, só hoje!"
    },
    {
      "type": "text",
      "id": "deadline",
      "label": "Fim do contador (ISO com fuso)",
      "info": "Formato: 2026-07-07T23:59:59-03:00 (fim do dia 07/07 no horário de Brasília).",
      "default": "2026-07-07T23:59:59-03:00"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Texto antes do contador",
      "default": "Termina em"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do botão",
      "default": "Aproveitar"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link do botão / da barra",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "label": "Mostrar só na página inicial",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Ocultar no mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundo (início)",
      "default": "#E4141C"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Fundo (fim)",
      "default": "#B00E14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque (timer / botão)",
      "default": "#FFD84D"
    }
  ],
  "presets": [
    {
      "name": "Dia D — Barra de urgência"
    }
  ]
}
{% endschema %}
