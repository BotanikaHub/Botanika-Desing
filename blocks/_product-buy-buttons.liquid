{% liquid
  assign block_st = block.settings
  assign product = closest.product
  assign products_group = product.metafields.custom.product_grouped
  assign product_form_id = 'product-form-' | append: section.id
%}
{%- if product.metafields.custom.external_affiliate == blank -%}
  {% if products_group == blank %}

    {%- comment -%} ============ BANNER CUPOM BOTANIKA ============ {%- endcomment -%}
    <div class="botanika-coupon-banner" id="botanika-coupon-banner-{{ section.id }}">
      <div class="botanika-coupon-banner__icon">🎟</div>
      <div class="botanika-coupon-banner__content">
        <div class="botanika-coupon-banner__label">PRIMEIRO CUPOM DA LOJA</div>
        <div class="botanika-coupon-banner__text">
          Use <strong id="botanika-coupon-code-{{ section.id }}">BOTANIKA</strong> e ganhe
          <strong>5% OFF</strong> em qualquer produto.
        </div>
      </div>
      <button type="button"
              class="botanika-coupon-banner__btn"
              data-coupon-code="BOTANIKA"
              data-section-id="{{ section.id }}">
        <span class="botanika-coupon-banner__btn-text">Copiar</span>
      </button>
    </div>

    <style>
      .botanika-coupon-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        margin: 0 0 20px 0;
        background: #F8F0E8;
        border: 1.5px dashed #303890;
        border-radius: 14px;
        font-family: inherit;
        position: relative;
        overflow: hidden;
      }
      .botanika-coupon-banner::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 6px;
        background: #D0E088;
      }
      .botanika-coupon-banner__icon {
        font-size: 28px;
        line-height: 1;
        flex-shrink: 0;
      }
      .botanika-coupon-banner__content {
        flex: 1;
        min-width: 0;
      }
      .botanika-coupon-banner__label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #303890;
        opacity: 0.75;
        margin-bottom: 4px;
      }
      .botanika-coupon-banner__text {
        font-size: 15px;
        line-height: 1.4;
        color: #181010;
      }
      .botanika-coupon-banner__text strong {
        color: #303890;
        font-weight: 700;
      }
      .botanika-coupon-banner__text strong[id^="botanika-coupon-code"] {
        background: #F8C840;
        padding: 1px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        color: #303890;
      }
      .botanika-coupon-banner__btn {
        background: #303890;
        color: #F8F0E8;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 150ms ease-out;
        flex-shrink: 0;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
      }
      .botanika-coupon-banner__btn:hover {
        background: #1f2670;
        transform: translateY(-1px);
      }
      .botanika-coupon-banner__btn.copied {
        background: #4A7C3E;
      }
      @media (max-width: 600px) {
        .botanika-coupon-banner {
          flex-wrap: wrap;
          padding: 14px 16px;
        }
        .botanika-coupon-banner__btn {
          width: 100%;
          margin-top: 8px;
        }
        .botanika-coupon-banner__text {
          font-size: 14px;
        }
      }
    </style>

    <script>
      (function () {
        var banner = document.getElementById('botanika-coupon-banner-{{ section.id }}');
        if (!banner) return;
        var btn = banner.querySelector('.botanika-coupon-banner__btn');
        if (!btn) return;
        if (btn.dataset.botanikaInit === '1') return;
        btn.dataset.botanikaInit = '1';

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();

          var code = btn.getAttribute('data-coupon-code') || 'BOTANIKA';
          var btnText = btn.querySelector('.botanika-coupon-banner__btn-text');

          var showCopied = function () {
            if (btnText) btnText.textContent = '✓ Copiado';
            btn.classList.add('copied');
            setTimeout(function () {
              if (btnText) btnText.textContent = 'Copiar';
              btn.classList.remove('copied');
            }, 2500);
          };

          var fallbackCopy = function (text) {
            var t = document.createElement('textarea');
            t.value = text;
            t.style.position = 'fixed';
            t.style.left = '-9999px';
            t.style.top = '0';
            t.setAttribute('readonly', '');
            document.body.appendChild(t);
            t.focus();
            t.select();
            try { document.execCommand('copy'); } catch (err) {}
            document.body.removeChild(t);
            showCopied();
          };

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(code).then(showCopied, function () {
              fallbackCopy(code);
            });
          } else {
            fallbackCopy(code);
          }
        });
      })();
    </script>
    {%- comment -%} ============ FIM BANNER CUPOM BOTANIKA ============ {%- endcomment -%}

    <div
      class="product-detail__buy-buttons button-trigger__sticky mb-20"
      {{ block.shopify_attributes }}
    >
      {%- render 'buy-buttons',
        block: block,
        product: product,
        product_form_id: product_form_id,
        section_id: section.id,
        show_wishlist: block_st.show_wishlist,
        show_compare: block_st.show_compare,
        formClass: 'feature-product-form',
        type: 'main_product'
      -%}
    </div>
  {% endif %}
{%- else -%}
  <a
    href="{{ product.metafields.custom.external_affiliate.value.external_link }}"
    rel="nofollow"
    target="_blank"
    class="btn product-form__submit relative text-center w-full whitespace-nowrap animation flash-move block btn-primary no-underline{% if enable_skeleton_loading %} skeleton-loading{% endif %}"
  >
    {{- product.metafields.custom.external_affiliate.value.button_text -}}
  </a>
{%- endif -%}
{% schema %}
{
  "name": "t:blocks.product.buy_buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
      "info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
    },
    {
      "type": "checkbox",
      "id": "show_gift_card_recipient",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
      "info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_wishlist"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_compare"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product.buy_buttons.name"
    }
  ]
}
{% endschema %}
