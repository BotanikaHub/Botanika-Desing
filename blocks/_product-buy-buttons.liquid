{% liquid
  assign block_st = block.settings
  assign product = closest.product
  assign products_group = product.metafields.custom.product_grouped
  assign product_form_id = 'product-form-' | append: section.id
%}
{%- if product.metafields.custom.external_affiliate == blank -%}
  {% if products_group == blank %}

    {%- comment -%} ============ BANNER DIA D BOTANIKA (8% OFF) ============ {%- endcomment -%}
    {%- comment -%} Deadline do Dia D (fim do dia 07/07 no horário de Brasília, UTC-3) {%- endcomment -%}
    <div
      class="diad-pdp-banner"
      id="diad-pdp-banner-{{ section.id }}"
      data-diad-deadline="2026-07-07T23:59:59-03:00"
    >
      <div class="diad-pdp-banner__fire">🔥</div>
      <div class="diad-pdp-banner__content">
        <div class="diad-pdp-banner__label">DIA D BOTANIKA</div>
        <div class="diad-pdp-banner__text">
          <strong>8% OFF</strong> em todo o site — o desconto entra
          <strong>automaticamente</strong> no seu carrinho. Sem cupom.
        </div>
      </div>
      <div class="diad-pdp-banner__timer" aria-live="off">
        <span class="diad-pdp-banner__timer-label">Termina em</span>
        <span class="diad-pdp-banner__clock" data-diad-clock>--:--:--</span>
      </div>
    </div>

    <style>
      .diad-pdp-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        margin: 0 0 20px 0;
        background: linear-gradient(120deg, #303890 0%, #1f2670 100%);
        border-radius: 14px;
        font-family: inherit;
        position: relative;
        overflow: hidden;
        color: #ffffff;
      }
      .diad-pdp-banner::before {
        content: '';
        position: absolute;
        inset: 0 0 0 0;
        background: radial-gradient(circle at 100% 0%, rgba(248, 200, 64, 0.22), transparent 55%);
        pointer-events: none;
      }
      .diad-pdp-banner__fire {
        font-size: 30px;
        line-height: 1;
        flex-shrink: 0;
        filter: drop-shadow(0 0 8px rgba(248, 200, 64, 0.55));
        animation: diadFlame 1.4s ease-in-out infinite;
      }
      @keyframes diadFlame {
        0%, 100% { transform: scale(1) rotate(-3deg); }
        50% { transform: scale(1.12) rotate(3deg); }
      }
      .diad-pdp-banner__content {
        flex: 1;
        min-width: 0;
        position: relative;
        z-index: 1;
      }
      .diad-pdp-banner__label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #F8C840;
        margin-bottom: 4px;
      }
      .diad-pdp-banner__text {
        font-size: 14.5px;
        line-height: 1.4;
        color: #ffffff;
      }
      .diad-pdp-banner__text strong {
        color: #ffffff;
        font-weight: 800;
      }
      .diad-pdp-banner__timer {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding-left: 14px;
        border-left: 1px solid rgba(255, 255, 255, 0.18);
        position: relative;
        z-index: 1;
      }
      .diad-pdp-banner__timer-label {
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.75;
      }
      .diad-pdp-banner__clock {
        font-size: 18px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.02em;
        color: #F8C840;
        white-space: nowrap;
      }
      @media (max-width: 600px) {
        .diad-pdp-banner {
          flex-wrap: wrap;
          padding: 12px 14px;
          gap: 10px;
        }
        .diad-pdp-banner__timer {
          border-left: none;
          padding-left: 0;
          flex-direction: row;
          align-items: baseline;
          gap: 6px;
          width: 100%;
          padding-top: 8px;
          border-top: 1px solid rgba(255, 255, 255, 0.18);
        }
        .diad-pdp-banner__text {
          font-size: 13.5px;
        }
      }
    </style>

    <script>
      (function () {
        var banner = document.getElementById('diad-pdp-banner-{{ section.id }}');
        if (!banner || banner.dataset.diadInit === '1') return;
        banner.dataset.diadInit = '1';

        var clock = banner.querySelector('[data-diad-clock]');
        var deadline = new Date(banner.getAttribute('data-diad-deadline')).getTime();
        if (!clock || isNaN(deadline)) return;

        function pad(n) { return (n < 10 ? '0' : '') + n; }

        function tick() {
          var diff = deadline - Date.now();
          if (diff <= 0) {
            clock.textContent = '00:00:00';
            clearInterval(timer);
            return;
          }
          var totalSec = Math.floor(diff / 1000);
          var days = Math.floor(totalSec / 86400);
          var hours = Math.floor((totalSec % 86400) / 3600);
          var mins = Math.floor((totalSec % 3600) / 60);
          var secs = totalSec % 60;
          clock.textContent =
            (days > 0 ? days + 'd ' : '') + pad(hours) + ':' + pad(mins) + ':' + pad(secs);
        }

        tick();
        var timer = setInterval(tick, 1000);
      })();
    </script>
    {%- comment -%} ============ FIM BANNER DIA D BOTANIKA ============ {%- endcomment -%}

    <div
      class="product-detail__buy-buttons button-trigger__sticky mb-20"
      {{ block.shopify_attributes }}
    >
      {%- render 'buy-buttons',
        block: block,
        product: product,
        product_form_id: product_form_id,
        section_id: section.id,
        show_wishlist: block_st.show_wishlist,
        show_compare: block_st.show_compare,
        formClass: 'feature-product-form',
        type: 'main_product'
      -%}
    </div>
  {% endif %}
{%- else -%}
  <a
    href="{{ product.metafields.custom.external_affiliate.value.external_link }}"
    rel="nofollow"
    target="_blank"
    class="btn product-form__submit relative text-center w-full whitespace-nowrap animation flash-move block btn-primary no-underline{% if enable_skeleton_loading %} skeleton-loading{% endif %}"
  >
    {{- product.metafields.custom.external_affiliate.value.button_text -}}
  </a>
{%- endif -%}
{% schema %}
{
  "name": "t:blocks.product.buy_buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
      "info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
    },
    {
      "type": "checkbox",
      "id": "show_gift_card_recipient",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
      "info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_wishlist"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "default": true,
      "label": "t:sections.main-product.blocks.buy_buttons.settings.show_compare"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product.buy_buttons.name"
    }
  ]
}
{% endschema %}
