{%- comment -%}
  ============================================================
  Depoimentos (carrossel) DENTRO das informações do produto.
  Bloco da seção main-product. Aparece abaixo do botão de compra.
  Até 8 fotos (imagem + nome + frase opcionais).
  ============================================================
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign has_photo = false
  for i in (1..8)
    assign pk = 'p' | append: i
    if bs[pk] != blank
      assign has_photo = true
    endif
  endfor
-%}
{%- if has_photo or request.design_mode -%}
  <div class="pdep" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}<h3 class="pdep__title">{{ bs.heading }}</h3>{%- endif -%}
    {%- if bs.subheading != blank -%}<p class="pdep__sub">{{ bs.subheading }}</p>{%- endif -%}
    <div class="pdep__row">
      {%- for i in (1..8) -%}
        {%- assign pk = 'p' | append: i -%}
        {%- assign nk = 'n' | append: i -%}
        {%- assign ck = 'c' | append: i -%}
        {%- assign photo = bs[pk] -%}
        {%- if photo != blank -%}
          <div class="pdep__card">
            <div class="pdep__media">
              {{ photo | image_url: width: 640 | image_tag: loading: 'lazy', class: 'pdep__img', alt: bs[nk] | default: 'Depoimento Botanika' }}
            </div>
            {%- if bs.show_stars or bs[ck] != blank or bs[nk] != blank -%}
              <div class="pdep__info">
                {%- if bs.show_stars -%}<span class="pdep__stars">★★★★★</span>{%- endif -%}
                {%- if bs[ck] != blank -%}<span class="pdep__quote">{{ bs[ck] }}</span>{%- endif -%}
                {%- if bs[nk] != blank -%}<span class="pdep__name">{{ bs[nk] }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- style -%}
    .pdep { margin: 8px 0 24px; }
    .pdep__title { font-size: 19px; font-weight: 800; margin: 0 0 4px; color: #1a1e3a; }
    .pdep__sub { font-size: 13.5px; opacity: .75; margin: 0 0 14px; }
    .pdep__row { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; -webkit-overflow-scrolling: touch; }
    .pdep__row::-webkit-scrollbar { height: 6px; }
    .pdep__row::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 999px; }
    .pdep__card { flex: 0 0 auto; width: 190px; scroll-snap-align: start; background: #fff; border: 1px solid #eee; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 16px rgba(0,0,0,.06); }
    .pdep__media { aspect-ratio: 4 / 5; background: #eef0f5; }
    .pdep__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pdep__info { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 3px; }
    .pdep__stars { color: #f5a623; font-size: 13px; letter-spacing: 1px; }
    .pdep__quote { font-size: 13px; line-height: 1.35; color: #333; }
    .pdep__name { font-weight: 700; font-size: 12.5px; color: #111; }
  {%- endstyle -%}
{%- endif -%}
