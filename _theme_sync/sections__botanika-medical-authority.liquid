{%- comment -%}
  Botanika — Especialistas / Autoridade Médica (carrossel)
  Estilo de referência (Bigens): fotos circulares, citação, nome em
  destaque e credencial, em um carrossel horizontal com scroll-snap
  (arrasta no dedo; setas no desktop). Cada especialista é um bloco
  "doctor". O campo "quote" é opcional: se vazio, usa a "Frase neutra".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | replace: '-', ''
-%}
<div
  class="bt-medauth"
  style="--bt-brand: {{ s.brand_color }}; --bt-accent: {{ s.accent_color }}; --bt-bg: {{ s.bg_color }}; --bt-card: {{ s.card_color }}; --bt-pt: {{ s.padding_top }}px; --bt-pb: {{ s.padding_bottom }}px; --bt-card-w: {{ s.card_width }}px;"
>
  <div class="bt-medauth__wrap">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="bt-medauth__head">
        {%- if s.eyebrow != blank -%}<p class="bt-medauth__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="bt-medauth__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="bt-medauth__sub rich__text-m0">{{ s.subheading }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="bt-medauth__carousel">
      <button type="button" class="bt-medauth__nav bt-medauth__nav--prev" data-medauth-prev aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="bt-medauth__track" id="bt-medauth-track-{{ uid }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- liquid
            assign focus_x = b.photo_focus_x | default: 50
            assign focus_y = b.photo_focus_y | default: 30
            assign zoom_pct = b.photo_zoom | default: 100
            assign zoom = zoom_pct | times: 1.0 | divided_by: 100
            assign img_style = 'object-position: ' | append: focus_x | append: '% ' | append: focus_y | append: '%; transform: scale(' | append: zoom | append: ');'
          -%}
          <article class="bt-medauth__card" {{ block.shopify_attributes }}>
            <div class="bt-medauth__avatar">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 440 | image_tag: loading: 'lazy', widths: '220,330,440', class: 'bt-medauth__img', alt: b.name, style: img_style }}
              {%- else -%}
                <div class="bt-medauth__img bt-medauth__ph">🩺</div>
              {%- endif -%}
            </div>
            <div class="bt-medauth__body">
              {%- if b.quote != blank -%}
                <div class="bt-medauth__quote">{{ b.quote }}</div>
              {%- elsif s.neutral_quote != blank -%}
                <div class="bt-medauth__quote"><p>{{ s.neutral_quote }}</p></div>
              {%- endif -%}
              {%- if b.name != blank -%}<p class="bt-medauth__name">{{ b.name }}</p>{%- endif -%}
              {%- if b.specialty != blank or b.crm != blank -%}
                <p class="bt-medauth__meta">
                  {%- if b.specialty != blank -%}<span class="bt-medauth__spec">{{ b.specialty }}</span>{%- endif -%}
                  {%- if b.crm != blank -%}<span class="bt-medauth__crm">{{ b.crm }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if b.instagram != blank -%}
                {%- assign ig = b.instagram | replace: '@', '' | strip -%}
                <a class="bt-medauth__ig" href="{% if b.instagram_url != blank %}{{ b.instagram_url }}{% else %}https://instagram.com/{{ ig }}{% endif %}" target="_blank" rel="noopener nofollow" aria-label="Instagram de {{ b.name }}">@{{ ig }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      <button type="button" class="bt-medauth__nav bt-medauth__nav--next" data-medauth-next aria-label="Próximo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</div>

{% stylesheet %}
  .bt-medauth { padding-top: var(--bt-pt, 56px); padding-bottom: var(--bt-pb, 56px); background: var(--bt-bg, #f8f7f5); }
  .bt-medauth__wrap { max-width: 1240px; margin: 0 auto; padding: 0 20px; }
  .bt-medauth__head { text-align: center; max-width: 760px; margin: 0 auto 34px; }
  .bt-medauth__eyebrow { color: var(--bt-accent, #323C91); font-weight: 800; letter-spacing: .16em; text-transform: uppercase; font-size: 12px; margin: 0 0 10px; }
  .bt-medauth__title { color: var(--bt-brand, #323C91); font-weight: 800; letter-spacing: -.01em; font-size: clamp(22px, 2.8vw, 32px); line-height: 1.2; margin: 0 0 10px; }
  .bt-medauth__sub { color: #7a7f8c; font-size: clamp(14px, 1.3vw, 16px); line-height: 1.5; }

  .bt-medauth__carousel { position: relative; }
  .bt-medauth__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 6px 2px 10px;
  }
  .bt-medauth__track::-webkit-scrollbar { display: none; }

  .bt-medauth__card {
    flex: 0 0 var(--bt-card-w, 340px);
    scroll-snap-align: start;
    background: var(--bt-card, #fff);
    border-radius: 22px;
    padding: 34px 28px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 12px 34px rgba(20, 20, 40, .06);
    box-sizing: border-box;
  }
  .bt-medauth__avatar {
    flex: 0 0 auto;
    width: 132px; height: 132px;
    border-radius: 50%;
    overflow: hidden;
    background: #eef0f6;
    margin-bottom: 18px;
    box-shadow: 0 0 0 4px rgba(50, 60, 145, .08);
  }
  .bt-medauth__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bt-medauth__ph { display: flex; align-items: center; justify-content: center; font-size: 40px; }
  .bt-medauth__body { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; }
  .bt-medauth__quote { color: #4a4d57; font-size: 14.5px; line-height: 1.6; font-weight: 400; margin: 0 0 16px; }
  .bt-medauth__quote p { margin: 0; }
  .bt-medauth__quote p:first-child:before { content: '\201C'; }
  .bt-medauth__quote p:last-child:after { content: '\201D'; }
  .bt-medauth__quote strong, .bt-medauth__quote b { font-weight: 700; color: #2f313a; }
  .bt-medauth__name { color: var(--bt-brand, #323C91); font-weight: 800; font-size: 18px; line-height: 1.25; margin: 0; }
  .bt-medauth__meta { margin: 7px 0 0; line-height: 1.4; }
  .bt-medauth__spec { display: block; color: #9a9ea8; font-size: 13px; }
  .bt-medauth__crm { display: block; margin-top: 2px; color: #5b5e69; font-size: 13px; font-weight: 700; white-space: nowrap; }
  .bt-medauth__ig { margin-top: 10px; color: var(--bt-accent, #323C91); font-weight: 700; font-size: 13px; text-decoration: none; }
  .bt-medauth__ig:hover { text-decoration: underline; }

  .bt-medauth__nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 2;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgba(50, 60, 145, .16);
    background: #fff; color: var(--bt-brand, #323C91);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 6px 18px rgba(20, 20, 40, .10);
    transition: background .15s, color .15s, opacity .15s;
  }
  .bt-medauth__nav:hover { background: var(--bt-brand, #323C91); color: #fff; }
  .bt-medauth__nav--prev { left: -8px; }
  .bt-medauth__nav--next { right: -8px; }
  @media (max-width: 1024px) { .bt-medauth__nav { display: none; } }

  @media (max-width: 640px) {
    .bt-medauth__card { padding: 30px 22px 26px; }
    .bt-medauth__avatar { width: 118px; height: 118px; }
  }
{% endstylesheet %}

<script>
  (function () {
    var track = document.getElementById('bt-medauth-track-{{ uid }}');
    if (!track) return;
    var carousel = track.closest('.bt-medauth__carousel');
    if (!carousel) return;
    function step() {
      var card = track.querySelector('.bt-medauth__card');
      var w = card ? card.getBoundingClientRect().width : track.clientWidth * 0.8;
      return w + 20;
    }
    var prev = carousel.querySelector('[data-medauth-prev]');
    var next = carousel.querySelector('[data-medauth-next]');
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  })();
</script>

{% schema %}
{
  "name": "Autoridade Médica",
  "tag": "section",
  "class": "section-bt-medauth",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Largura",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "fluid_container", "label": "Fluido" },
        { "value": "full_width", "label": "Largura total" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Sobre-título", "default": "AUTORIDADE MÉDICA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Especialistas da saúde que confiam e recomendam a Botanika" },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo", "default": "<p>Médicos e especialistas que conhecem nossos protocolos.</p>" },
    {
      "type": "textarea",
      "id": "neutral_quote",
      "label": "Frase neutra (placeholder)",
      "info": "Usada nos cards que ainda não têm depoimento real preenchido no bloco do médico.",
      "default": "Conheço os protocolos da Botanika e recomendo aos meus pacientes."
    },
    { "type": "header", "content": "Aparência" },
    { "type": "range", "id": "card_width", "label": "Largura do card", "min": 260, "max": 460, "step": 10, "unit": "px", "default": 340 },
    { "type": "color", "id": "brand_color", "label": "Cor da marca (título + nome)", "default": "#323C91" },
    { "type": "color", "id": "accent_color", "label": "Cor de destaque", "default": "#323C91" },
    { "type": "color", "id": "bg_color", "label": "Fundo da seção", "default": "#F5F6FB" },
    { "type": "color", "id": "card_color", "label": "Fundo do card", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 140, "step": 4, "default": 56, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 140, "step": 4, "default": 56, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "doctor",
      "name": "Médico",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "range", "id": "photo_zoom", "label": "Zoom da foto", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 100 },
        { "type": "range", "id": "photo_focus_x", "label": "Posição horizontal do rosto", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "range", "id": "photo_focus_y", "label": "Posição vertical do rosto", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
        { "type": "text", "id": "name", "label": "Nome", "default": "Dr. Nome Sobrenome" },
        { "type": "text", "id": "crm", "label": "Registro (CRM / CRO / CFO)" },
        { "type": "text", "id": "specialty", "label": "Especialidade / papel" },
        { "type": "richtext", "id": "quote", "label": "Frase / depoimento (opcional)", "info": "Selecione um trecho e use negrito para destacar, como no exemplo de referência." },
        { "type": "text", "id": "instagram", "label": "Instagram (sem @)" },
        { "type": "url", "id": "instagram_url", "label": "Link do Instagram (opcional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Autoridade Médica",
      "blocks": [ { "type": "doctor" }, { "type": "doctor" }, { "type": "doctor" } ]
    }
  ]
}
{% endschema %}
