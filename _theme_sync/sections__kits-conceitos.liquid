<style>
.bk{--ink:#1b2560;--muted:#6b6f80;--blue:#323c91;--green:#c4d78a;--greenbtn:#10c322}
.bk *{box-sizing:border-box}
.bk__head{text-align:center;max-width:1200px;margin:0 auto 30px;padding:0 16px}
.bk__eb{color:#1a8f3c;font-weight:700;font-size:12px;letter-spacing:.16em;text-transform:uppercase}
.bk__h{font-size:clamp(24px,3vw,36px);font-weight:800;color:var(--ink);margin:8px 0 0;line-height:1.1}
.bk__sub{color:var(--muted);font-size:16px;margin:10px auto 0;max-width:52ch}
.bk__marquee{overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.bk__track{display:flex;gap:24px;width:max-content;padding:10px 12px;animation:bkroll 40s linear infinite}
.bk__marquee:hover .bk__track{animation-play-state:paused}
@keyframes bkroll{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 12px))}}
.bkc{flex:0 0 330px;width:330px;background:#fff;border:2px solid #eef0fa;border-radius:26px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 10px 30px rgba(27,37,96,.07);transition:border-color .15s,transform .15s}
.bkc:hover{border-color:var(--green);transform:translateY(-4px)}
.bkc__media{position:relative;aspect-ratio:4/3;overflow:hidden;background:#f5f6fb}
.bkc__media img{width:100%;height:100%;object-fit:cover;display:block}
.bkc__combo{position:absolute;top:14px;left:14px;background:var(--blue);color:#fff;font-weight:800;font-size:11.5px;padding:5px 11px;border-radius:999px;letter-spacing:.04em}
.bkc__off{position:absolute;top:14px;right:14px;background:var(--greenbtn);color:#fff;font-weight:800;font-size:12px;padding:5px 10px;border-radius:999px}
.bkc__body{padding:18px 20px 22px;text-align:center;display:flex;flex-direction:column;gap:9px;flex:1}
.bkc__name{font-weight:800;font-size:16px;color:var(--ink);line-height:1.25;margin:0}
.bkc__chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
.bkc__chip{font-size:11.5px;font-weight:700;color:#1a8f3c;background:rgba(26,143,60,.1);border-radius:999px;padding:4px 10px}
.bkc__save{color:#1a8f3c;font-weight:800;font-size:13px;margin-top:2px}
.bkc__price{margin-top:2px}
.bkc__old{color:var(--muted);text-decoration:line-through;font-size:12.5px;margin-right:6px}
.bkc__now{font-weight:800;font-size:21px;color:var(--blue)}
.bkc__cash{color:var(--muted);font-size:12px;display:block;margin-top:1px}
.bkc__btn{margin-top:14px;background:var(--green);color:#232b66;font-weight:800;padding:14px;border-radius:999px;text-decoration:none;transition:background .15s}
.bkc__btn:hover{background:#b3ca72}
@media(prefers-reduced-motion:reduce){.bk__track{animation:none;flex-wrap:wrap;justify-content:center;width:auto}}
</style>
<div class="bk">
<div class="bk__head">
<span class="bk__eb">Combos Botanika ✨</span>
<h2 class="bk__h">Kits que simplificam sua rotina</h2>
<p class="bk__sub">Junte os produtos certos pra cada objetivo e economize.</p>
</div>
<div class="bk__marquee"><div class="bk__track">
{%- capture kitcards -%}
<article class="bkc"><div class="bkc__media"><span class="bkc__combo">COMBO IMUNIDADE</span><span class="bkc__off">10% OFF</span><img src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/kit-imunidade-hero.png" alt="Kit Imunidade Botanika" loading="lazy"></div><div class="bkc__body"><h3 class="bkc__name">TetraVit D + Ômega 3 + Vitamina C</h3><div class="bkc__chips"><span class="bkc__chip">defesa</span><span class="bkc__chip">energia</span><span class="bkc__chip">antioxidante</span></div><span class="bkc__save">💚 Economize R$ 40,19</span><div class="bkc__price"><span class="bkc__old">R$ 401,90</span><span class="bkc__now">R$ 361,71</span><span class="bkc__cash">3x de R$ 120,57 sem juros</span></div><a class="bkc__btn" href="/products/kit-da-imunidade">Eu quero esse combo</a></div></article>
<article class="bkc"><div class="bkc__media"><span class="bkc__combo">COMBO FITNESS</span><span class="bkc__off">10% OFF</span><img src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/kit-fitness-hero-v2.png" alt="Kit Fitness Botanika" loading="lazy"></div><div class="bkc__body"><h3 class="bkc__name">Whey + Creatina + Magnésio Taurato</h3><div class="bkc__chips"><span class="bkc__chip">força</span><span class="bkc__chip">massa</span><span class="bkc__chip">recuperação</span></div><span class="bkc__save">💚 Economize R$ 27,56</span><div class="bkc__price"><span class="bkc__old">R$ 275,60</span><span class="bkc__now">R$ 248,04</span><span class="bkc__cash">3x de R$ 82,68 sem juros</span></div><a class="bkc__btn" href="/products/kit-whey-balance-creatina-taurato">Eu quero esse combo</a></div></article>
<article class="bkc"><div class="bkc__media"><span class="bkc__combo">COMBO SONO</span><span class="bkc__off">10% OFF</span><img src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/kit-sono-hero.png" alt="Kit Sono Botanika" loading="lazy"></div><div class="bkc__body"><h3 class="bkc__name">Sleep Inositol + Tri[Mg] Complex</h3><div class="bkc__chips"><span class="bkc__chip">sono</span><span class="bkc__chip">relaxa</span><span class="bkc__chip">calma</span></div><span class="bkc__save">💚 Economize R$ 20,72</span><div class="bkc__price"><span class="bkc__old">R$ 207,20</span><span class="bkc__now">R$ 186,48</span><span class="bkc__cash">3x de R$ 62,16 sem juros</span></div><a class="bkc__btn" href="/products/kit-sono-relaxamento">Eu quero esse combo</a></div></article>
{%- endcapture -%}
