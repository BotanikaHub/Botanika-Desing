        "section_width": "full_width",
        "color_scheme": "default",
        "custom_liquid": "<style>\n.btw{--ink:#1b2560;--muted:#6b6f80;--line:#eceef6;--blue:#323c91;--star:#ff9c05;--green:#1a8f3c}\n.btw__wrap{max-width:1200px;margin:0 auto;padding:0 16px}\n.btw__head{text-align:center;margin-bottom:38px}\n.btw__title{font-size:clamp(26px,3vw,38px);font-weight:800;color:var(--ink);margin:0 0 10px}\n.btw__sub{font-size:16px;color:var(--muted);margin:0 auto;max-width:56ch}\n.btw__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;align-items:stretch}\n.btc{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px 24px;box-shadow:0 8px 26px rgba(27,37,96,.06)}\n.btc__stars{color:var(--star);font-size:18px;letter-spacing:2px;line-height:1}\n.btc__quote{color:var(--ink);font-size:15.5px;line-height:1.62;margin:14px 0 18px;flex:1}\n.btc__author{font-weight:700;color:var(--ink);font-size:15px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.btc__vf{display:inline-flex;align-items:center;gap:5px;font-weight:600;font-size:12px;color:var(--green);background:rgba(26,143,60,.1);padding:4px 9px;border-radius:999px}\n.btc__vf svg{width:13px;height:13px}\n.btc__prod{display:flex;align-items:center;gap:14px;margin-top:18px;padding-top:18px;border-top:1px solid var(--line);text-decoration:none}\n.btc__thumb{flex:0 0 70px;width:70px;height:70px;border-radius:14px;background:#f5f6fb;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.btc__thumb img{width:100%;height:100%;object-fit:contain;padding:6px}\n.btc__pinfo{min-width:0}\n.btc__pname{font-weight:700;color:var(--ink);font-size:14px;line-height:1.3;margin-bottom:5px}\n.btc__old{color:var(--muted);text-decoration:line-through;font-size:12.5px;margin-right:6px}\n.btc__inst{display:block;color:var(--blue);font-weight:800;font-size:15px}\n.btc__nofee{display:inline-block;background:rgba(26,143,60,.12);color:var(--green);font-weight:700;font-size:11px;padding:2px 7px;border-radius:6px;margin-left:5px;vertical-align:middle}\n.btc__cash{display:block;color:var(--muted);font-size:12px;margin-top:2px}\n@media(max-width:900px){.btw__grid{grid-template-columns:1fr;gap:18px}.btw__head{margin-bottom:26px}}\n</style>\n<div class=\"btw\"><div class=\"btw__wrap\">\n<div class=\"btw__head\">\n<h2 class=\"btw__title\">O que dizem nossos clientes!</h2>\n<p class=\"btw__sub\">Nossos clientes amam nossos produtos e nos esforçamos para agradar a todos.</p>\n</div>\n<div class=\"btw__grid\">\n{%- assign t_h = \"super-omega-3-coq10|tri-mg-complex|sleep-inositol\" | split: \"|\" -%}\n{%- assign t_n = \"Angela M.|Rita M.|Marina L.\" | split: \"|\" -%}\n{%- assign t_q = \"Tinha muitas dores de cabeça e ao começar a tomar o OMEGA 3,senti que minhas dores reduziram. 😍|O Magnésio fez toda a diferença na minha rotina e na da minha filha de 21 anos, enfrentava um quadro de ansiedade, notável a diferença em 30 dias, os exercícios na academia se tornaram mais felizes.|Após duas semanas de uso do Sleep inositol, notei uma melhora na qualidade do sono e também na regulação da pressão arterial.\" | split: \"|\" -%}\n{%- for h in t_h -%}\n{%- assign p = all_products[h] -%}\n<article class=\"btc\">\n<div class=\"btc__stars\">★★★★★</div>\n<p class=\"btc__quote\">{{ t_q[forloop.index0] }}</p>\n<div class=\"btc__author\">{{ t_n[forloop.index0] }} <span class=\"btc__vf\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>Compra verificada</span></div>\n<a class=\"btc__prod\" href=\"{{ p.url }}\">\n<span class=\"btc__thumb\">{%- if p.featured_image -%}<img src=\"{{ p.featured_image | image_url: width: 160 }}\" alt=\"{{ p.title | escape }}\" loading=\"lazy\">{%- endif -%}</span>\n<span class=\"btc__pinfo\">\n<span class=\"btc__pname\">{{ p.title }}</span>\n{%- if p.compare_at_price > p.price -%}<span class=\"btc__old\">{{ p.compare_at_price | money }}</span>{%- endif -%}\n<span class=\"btc__inst\">3x de {{ p.price | divided_by: 3 | money }}<span class=\"btc__nofee\">sem juros</span></span>\n<span class=\"btc__cash\">ou {{ p.price | money }} à vista</span>\n</span>\n</a>\n</article>\n{%- endfor -%}\n</div>\n</div></div>",
        "padding_top": 40,
        "padding_bottom": 40,
        "reset_spacing": false
      }
