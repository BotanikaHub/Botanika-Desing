    "bloco_saude_novo": {
      "type": "custom-liquid",
      "settings": {
        "section_width": "full_width",
        "color_scheme": "default",
        "custom_liquid": "<style>\n.bsn{--verde:#c4d78a;--azd:#232b66}\n.bsn__wrap{max-width:1200px;margin:0 auto;padding:0 16px}\n.bsn__panel{position:relative;border-radius:26px;overflow:hidden;background:radial-gradient(120% 140% at 12% 8%,#3a44a0 0%,#232b66 72%);display:grid;grid-template-columns:1.05fr 1fr;box-shadow:0 20px 50px rgba(27,37,96,.18)}\n.bsn__media{position:relative;min-height:430px}\n.bsn__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n.bsn__media::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(35,43,102,0) 58%,rgba(35,43,102,.55) 100%)}\n.bsn__content{padding:50px 54px;color:#fff;display:flex;flex-direction:column;justify-content:center;gap:16px}\n.bsn__eb{font-weight:700;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--verde)}\n.bsn__h{font-size:clamp(26px,3vw,42px);line-height:1.1;font-weight:800;margin:0;color:#fff !important}\n.bsn__sub{font-size:15px;line-height:1.6;color:#d6d9f2;margin:0;max-width:44ch}\n.bsn__chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}\n.bsn__chip{display:inline-flex;align-items:center;gap:8px;border:1.5px solid rgba(255,255,255,.45);border-radius:999px;padding:9px 15px;font-size:13.5px;font-weight:600;color:#fff}\n.bsn__chip svg{width:16px;height:16px;flex:0 0 16px}\n.bsn__cta{align-self:flex-start;margin-top:12px;background:#fff;color:var(--azd);font-weight:700;font-size:15px;text-decoration:none;padding:15px 28px;border-radius:999px;transition:transform .15s ease,box-shadow .15s ease}\n.bsn__cta:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.18)}\n@media(max-width:820px){.bsn__panel{grid-template-columns:1fr}.bsn__media{min-height:250px}.bsn__media::after{background:linear-gradient(180deg,rgba(35,43,102,0) 55%,rgba(35,43,102,.45) 100%)}.bsn__content{padding:32px 26px}}\n</style>\n<div class=\"bsn\"><div class=\"bsn__wrap\"><div class=\"bsn__panel\">\n<div class=\"bsn__media\"><img src=\"https://cdn.shopify.com/s/files/1/0780/7238/1672/files/bloco-saude-hero.png\" alt=\"Produtos Botanika\" loading=\"lazy\"></div>\n<div class=\"bsn__content\">\n<span class=\"bsn__eb\">Botanika</span>\n<h2 class=\"bsn__h\">Mais saúde para o seu dia</h2>\n<p class=\"bsn__sub\">Suplementos desenvolvidos com ingredientes premium para apoiar seu corpo e sua mente — do treino à rotina.</p>\n<div class=\"bsn__chips\">\n<span class=\"bsn__chip\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>Ingredientes naturais</span>\n<span class=\"bsn__chip\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 12l2 2 4-4\"/></svg>Certificação ANVISA</span>\n<span class=\"bsn__chip\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 2v6.5L5 17a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 17l-5-8.5V2\"/><path d=\"M8.5 2h7\"/></svg>Respaldo científico</span>\n</div>\n<a class=\"bsn__cta\" href=\"/collections/all\">Conhecer produtos</a>\n</div>\n</div></div></div>",
        "padding_top": 40,
        "padding_bottom": 40,
        "reset_spacing": false
      }
    },
