{%- comment -%}
  Botanika — Switch de Sabor (Whey)
  Renderiza SÓ em produtos com metafield custom.whey_flavors (lista de sabores/produtos).
  Pills para trocar de sabor: o sabor atual fica destacado; os outros linkam para a PDP.
  Como cada sabor é um produto separado, clicar troca foto/preço/botão de forma nativa.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign flavors = product.metafields.custom.whey_flavors.value
-%}
{%- if flavors != blank and flavors.size > 1 -%}
  <div class="bt-sw" style="--bt-brand: {{ s.brand_color }}; --bt-pt: {{ s.padding_top }}px; --bt-pb: {{ s.padding_bottom }}px;">
    <div class="bt-sw__wrap">
      {%- if s.label != blank -%}<p class="bt-sw__label">{{ s.label }}</p>{%- endif -%}
      <div class="bt-sw__pills" role="list">
        {%- for fp in flavors -%}
          {%- assign v = fp.selected_or_first_available_variant -%}
          {%- assign name = fp.metafields.custom.card_name | default: fp.title -%}
          {%- assign card_img = fp.metafields.custom.card_image.value | default: fp.featured_image -%}
          {%- assign is_current = false -%}
          {%- if fp.id == product.id -%}{%- assign is_current = true -%}{%- endif -%}
          {%- capture inner -%}
            <span class="bt-sw__thumb">
              {%- if card_img -%}
                {{ card_img | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: name, class: 'bt-sw__img' }}
              {%- else -%}<span class="bt-sw__ph">🥤</span>{%- endif -%}
            </span>
            <span class="bt-sw__info">
              <span class="bt-sw__name">{{ name }}</span>
              {%- if v and s.show_price -%}<span class="bt-sw__price">{{ v.price | money }}</span>{%- endif -%}
            </span>
          {%- endcapture -%}
          {%- if is_current -%}
            <span class="bt-sw__pill is-current" aria-current="true" role="listitem">{{ inner }}<span class="bt-sw__check">✓</span></span>
          {%- else -%}
            <a class="bt-sw__pill" href="{{ fp.url }}" role="listitem">{{ inner }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .bt-sw { padding-top: var(--bt-pt, 8px); padding-bottom: var(--bt-pb, 8px); }
  .bt-sw__wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  .bt-sw__label { font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #6b7080; margin: 0 0 8px; }
  .bt-sw__pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .bt-sw__pill { display: flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border: 2px solid #e7e9f2; border-radius: 14px; background: #fff; text-decoration: none; color: #14173a; transition: border-color .15s ease, box-shadow .15s ease, transform .05s ease; position: relative; min-width: 148px; }
  .bt-sw__pill:hover { border-color: #c4cae6; }
  .bt-sw__pill:active { transform: scale(.99); }
  .bt-sw__pill.is-current { border-color: var(--bt-brand, #15265c); box-shadow: 0 4px 14px rgba(21,38,92,.12); cursor: default; }
  .bt-sw__thumb { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 10px; overflow: hidden; background: #f2f4fb; display: flex; align-items: center; justify-content: center; }
  .bt-sw__img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .bt-sw__ph { font-size: 22px; }
  .bt-sw__info { display: flex; flex-direction: column; line-height: 1.15; }
  .bt-sw__name { font-weight: 700; font-size: 15px; color: #14173a; }
  .bt-sw__price { font-weight: 600; font-size: 13px; color: #6b7080; margin-top: 2px; }
  .bt-sw__check { margin-left: auto; color: var(--bt-brand, #15265c); font-weight: 800; font-size: 15px; padding-left: 8px; }
  @media (max-width: 480px) {
    .bt-sw__pills { gap: 8px; }
    .bt-sw__pill { min-width: 0; flex: 1 1 46%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Switch de Sabor (Whey)",
  "tag": "section",
  "class": "section-bt-switch",
  "settings": [
    { "type": "paragraph", "content": "Aparece apenas em produtos com o metafield custom.whey_flavors preenchido. Mostra os sabores como botões; o atual fica destacado e os outros levam à página do sabor." },
    { "type": "text", "id": "label", "label": "Rótulo", "default": "Escolha o sabor" },
    { "type": "checkbox", "id": "show_price", "label": "Mostrar preço no botão", "default": true },
    { "type": "color", "id": "brand_color", "label": "Cor da marca", "default": "#15265c" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [ { "name": "Switch de Sabor (Whey)" } ]
}
{% endschema %}
